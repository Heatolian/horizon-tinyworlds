<!--
  On-screen touch HUD (ScreenSpace) — LANDSCAPE build.

  This project's `screenOrientation` is Portrait, so the PORTRAIT sibling is the
  build currently wired. This file ships for a later orientation switch: if you
  wire it instead, TouchControlsHud.landscape / TouchJoystick.landscape /
  TouchCameraLook.landscape must all be set true so the landscape hit rects and
  zone splits are selected. Wire exactly one HUD build.

      d:DesignWidth / d:DesignHeight   2340 x 1080
      ReferenceResolution              2340,1080

  ROOT STRUCTURE follows creating-custom-ui: a <Component> wrapping a single
  noesis:LayoutScaler whose one child is a Grid. LayoutScaler scales the
  2340x1080 (19.5:9, matching the Figma frame) design space onto the device.
  CRITICAL: set the panel's
  CustomUiPlatformComponent width AND height to 0 explicitly so the layout size is
  inherited from d:DesignWidth/d:DesignHeight above. With d:Design ==
  ReferenceResolution and width/height = 0, the LayoutScaler collapses to an
  identity transform and only ONE net scale applies. Do NOT leave width/height
  absent: an unset panel defaults to 1920x1080 and double-scales this 2340x1080
  panel. Setting them (or the legacy vrLayoutWidth/Height) to any other nonzero
  value double-scales the same way.

  The Canvas is HorizontalAlignment/VerticalAlignment=Stretch with no explicit
  Width/Height, so it fills the scaled design space and Canvas.Right/Canvas.Bottom
  anchor to the physical screen corner.

  Buttons sit in a bottom-right thumb cluster, matching the built-in
  GameplayControls. Landscape gives more horizontal room, so the cluster sits
  slightly further from the corner than portrait. Jump (160, jump tier) is the
  corner button; Interact and Drop (132, utility tier) are contextual. Use (195,
  primary tier) and Reload (132, utility tier) are contextual to the equipped
  weapon. Their image sources bind to TextureAsset fields authored on it. Drop
  sits directly above Jump with a 27px gap (Jump's top edge is at Canvas.Bottom
  543).

  TAP SIZE: every button is at least 132 design px and at least 24 px from its
  neighbours. The LayoutScaler fits 2340x1080 into the screen, so on a phone of
  at least 780x360 pt one design px is at least 1/3 pt: 132 px meets Apple's
  44 pt minimum tap target and 24 px is an 8 pt gap. A shorter screen scales
  lower (37.6 pt on a 667x375 pt 16:9 phone), and Android asks for 48 dp. Keep
  added buttons at or above both floors.

  INPUT COMES FROM THE ROUTER, NOT NOESIS. Touch is delivered by the shared
  TouchRouter, so these buttons have NO Command bindings and are display-only
  visuals; the entity's CustomUiPlatformComponent.isInteractable can be false.
  Each button's hit region is a normalized rect in TouchControlsHud.ts
  (BUTTON_CONFIGS, landscape set); the Canvas position and size below MUST match
  that rect, and TouchControlsHud.landscape MUST be true so the landscape rects
  are selected.

  Each button's pressed visual (a press-down ScaleTransform) binds to its
  `*Pressed` flag, which the router handlers set; Visibility and IsEnabled bind to
  the `*Visible` / `*Enabled` flags so the wrapper API still toggles them.

  The rest ScaleTransform is a Style <Setter> in TouchButtonStyle ON PURPOSE: a
  Style DataTrigger can override a Style setter but NOT a LOCAL value. Never move
  the rest RenderTransform/ScaleTransform onto the Button/Grid element as a local
  value, or the *Pressed DataTrigger loses precedence (Noesis: local > style
  trigger > style setter) and the press visual silently dies on tap AND hold.
-->
<Component
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions"
  mc:Ignorable="d"
  d:DesignWidth="2340"
  d:DesignHeight="1080">
  <noesis:LayoutScaler ReferenceResolution="2340,1080">
    <Grid>
      <!-- Scope: the view through a scoped weapon's sight while it is aimed. Display
           only, and first so every button draws over it; CrosshairTrigger shows it,
           fading it in, and the crosshair hides meanwhile. A black mask around a
           1000-across lens with a dark rim, and a duplex reticle: thick posts
           outside, fine cross hairs through the centre. The mask is larger than
           any screen, so it covers past the design area wherever that overscans. -->
      <Grid IsHitTestVisible="False">
        <Grid.Visibility>
          <Binding Path="scopeVisible" FallbackValue="Collapsed">
            <Binding.Converter>
              <BooleanToVisibilityConverter />
            </Binding.Converter>
          </Binding>
        </Grid.Visibility>
        <Grid.Style>
          <Style TargetType="Grid">
            <Style.Triggers>
              <DataTrigger Binding="{Binding scopeVisible}" Value="True">
                <DataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.EnterActions>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Path
          Width="4000"
          Height="4000"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Fill="#FF000000">
          <Path.Data>
            <GeometryGroup FillRule="EvenOdd">
              <RectangleGeometry Rect="0,0,4000,4000" />
              <EllipseGeometry Center="2000,2000" RadiusX="500" RadiusY="500" />
            </GeometryGroup>
          </Path.Data>
        </Path>
        <Grid Width="1000" Height="1000" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Ellipse Stroke="#FF000000" StrokeThickness="16" />
          <Rectangle Height="2" VerticalAlignment="Center" Fill="#FF000000" />
          <Rectangle Width="2" HorizontalAlignment="Center" Fill="#FF000000" />
          <Rectangle Width="320" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#FF000000" />
          <Rectangle Width="320" Height="10" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="#FF000000" />
          <Rectangle Width="10" Height="320" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="#FF000000" />
          <Rectangle Width="10" Height="320" HorizontalAlignment="Center" VerticalAlignment="Bottom" Fill="#FF000000" />
        </Grid>
      </Grid>

      <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <Canvas.Resources>
          <!-- Shared round touch-button style, identical to the portrait build:
               monochrome translucent theme matching the built-in
               GameplayControls.xaml. -->
          <Style x:Key="TouchButtonStyle" TargetType="Button">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
              <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
              </Setter.Value>
            </Setter>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Grid x:Name="bg">
                    <Ellipse Stretch="UniformToFill" StrokeThickness="1">
                      <Ellipse.Fill>
                        <SolidColorBrush Color="#FF000000" Opacity="0.4" />
                      </Ellipse.Fill>
                      <Ellipse.Stroke>
                        <SolidColorBrush Color="#FFFFFFFF" Opacity="0.2" />
                      </Ellipse.Stroke>
                    </Ellipse>
                    <ContentPresenter
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="bg" Property="Opacity" Value="0.4" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Canvas.Resources>

        <!-- Jump: jump tier, bottom-right corner. 160px. Rect must match
             BUTTON_CONFIGS 'Jump' (landscape) in TouchControlsHud.ts. -->
        <Button
          Width="160"
          Height="160"
          Canvas.Right="153"
          Canvas.Bottom="383"
          IsEnabled="{Binding Path=jumpEnabled}">
          <Button.Content>
            <Image
              Source="UI/icons/icn_Jump.png"
              Width="136"
              Height="136"
              Stretch="Uniform" />
          </Button.Content>
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource TouchButtonStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding jumpPressed}" Value="True">
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Button.Visibility>
            <Binding Path="jumpVisible" FallbackValue="Collapsed">
              <Binding.Converter>
                <BooleanToVisibilityConverter />
              </Binding.Converter>
            </Binding>
          </Button.Visibility>
        </Button>

        <!-- Use: primary tier, 195px. Visible while a weapon is equipped.
             Rect must match BUTTON_CONFIGS 'Use' (landscape). -->
        <Button
          Width="195"
          Height="195"
          Canvas.Right="380"
          Canvas.Bottom="383"
          IsEnabled="{Binding Path=useEnabled}">
          <Button.Content>
            <Image
              Source="{Binding Path=useIcon}"
              Width="166"
              Height="166"
              Stretch="Uniform" />
          </Button.Content>
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource TouchButtonStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding usePressed}" Value="True">
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Button.Visibility>
            <Binding Path="useVisible" FallbackValue="Collapsed">
              <Binding.Converter>
                <BooleanToVisibilityConverter />
              </Binding.Converter>
            </Binding>
          </Button.Visibility>
        </Button>

        <!-- Reload: utility tier, 132px. Visible only for a reloadable weapon.
             Rect must match BUTTON_CONFIGS 'Reload' (landscape). -->
        <Button
          Width="132"
          Height="132"
          Canvas.Right="599"
          Canvas.Bottom="415"
          IsEnabled="{Binding Path=reloadEnabled}">
          <Button.Content>
            <Image
              Source="{Binding Path=reloadIcon}"
              Width="112"
              Height="112"
              Stretch="Uniform" />
          </Button.Content>
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource TouchButtonStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding reloadPressed}" Value="True">
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Button.Visibility>
            <Binding Path="reloadVisible" FallbackValue="Collapsed">
              <Binding.Converter>
                <BooleanToVisibilityConverter />
              </Binding.Converter>
            </Binding>
          </Button.Visibility>
        </Button>

        <!-- Interact: utility tier, 132px, left of and below the Jump cluster.
             CONTEXTUAL — shown by InteractionControlsBridge on WSDK candidacy.
             Rect must match BUTTON_CONFIGS 'Interact' (landscape). -->
        <Button
          Width="132"
          Height="132"
          Canvas.Right="289"
          Canvas.Bottom="129"
          IsEnabled="{Binding Path=interactEnabled}">
          <Button.Content>
            <Image
              Source="UI/icons/icn_Interact.png"
              Width="112"
              Height="112"
              Stretch="Uniform" />
          </Button.Content>
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource TouchButtonStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding interactPressed}" Value="True">
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Button.Visibility>
            <Binding Path="interactVisible" FallbackValue="Collapsed">
              <Binding.Converter>
                <BooleanToVisibilityConverter />
              </Binding.Converter>
            </Binding>
          </Button.Visibility>
        </Button>

        <!-- Drop: utility tier, 132px, directly above Jump (centred on Jump's
             x axis, 27px above its top edge). CONTEXTUAL — shown by
             PlayerItemInput while the local player holds an item. Rect must
             match BUTTON_CONFIGS 'Drop' (landscape). -->
        <Button
          Width="132"
          Height="132"
          Canvas.Right="167"
          Canvas.Bottom="570"
          IsEnabled="{Binding Path=dropEnabled}">
          <Button.Content>
            <Image
              Source="UI/icons/icn_Drop.png"
              Width="112"
              Height="112"
              Stretch="Uniform" />
          </Button.Content>
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource TouchButtonStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding dropPressed}" Value="True">
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Button.Visibility>
            <Binding Path="dropVisible" FallbackValue="Collapsed">
              <Binding.Converter>
                <BooleanToVisibilityConverter />
              </Binding.Converter>
            </Binding>
          </Button.Visibility>
        </Button>

        <!-- SwitchWeapon: utility tier, 132px. CONTEXTUAL — switchWeaponVisible
             starts false and PlayerItemInput (scripts/GameContent) shows it only
             while there is another item to switch to. Placeholder label until an icon
             exists. Rect must match BUTTON_CONFIGS 'SwitchWeapon' (landscape). -->
        <Button
          Width="132"
          Height="132"
          Canvas.Right="609"
          Canvas.Bottom="259"
          IsEnabled="{Binding Path=switchWeaponEnabled}">
          <Button.Content>
            <TextBlock
              Text="SWAP"
              FontSize="28"
              FontWeight="Bold"
              Foreground="White"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
          </Button.Content>
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource TouchButtonStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding switchWeaponPressed}" Value="True">
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Button.Visibility>
            <Binding Path="switchWeaponVisible" FallbackValue="Collapsed">
              <Binding.Converter>
                <BooleanToVisibilityConverter />
              </Binding.Converter>
            </Binding>
          </Button.Visibility>
        </Button>


        <!-- Aim: utility tier, 132px, held. CONTEXTUAL - aimVisible starts false and
             PlayerItemInput shows it only while a scoped weapon is in hand. Rect must
             match BUTTON_CONFIGS 'Aim' (landscape). -->
        <Button
          Width="132"
          Height="132"
          Canvas.Right="599"
          Canvas.Bottom="571"
          IsEnabled="{Binding Path=aimEnabled}">
          <Button.Content>
            <TextBlock
              Text="AIM"
              Foreground="White"
              FontSize="34"
              FontWeight="Bold"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
          </Button.Content>
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource TouchButtonStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding aimPressed}" Value="True">
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Button.Visibility>
            <Binding Path="aimVisible" FallbackValue="Collapsed">
              <Binding.Converter>
                <BooleanToVisibilityConverter />
              </Binding.Converter>
            </Binding>
          </Button.Visibility>
        </Button>

        <!-- Dodge: ability tier, 135px, tap. CONTEXTUAL - dodgeVisible starts false and
             DodgeRollAbility shows it only on a local player that can roll. Rect must
             match BUTTON_CONFIGS 'Dodge' (landscape). icn_DodgeRoll = the roll glyph. -->
        <Button
          Width="135"
          Height="135"
          Canvas.Right="128"
          Canvas.Bottom="224"
          IsEnabled="{Binding Path=dodgeEnabled}">
          <Button.Content>
            <Image
              Source="UI/icons/icn_DodgeRoll.png"
              Width="114"
              Height="114"
              Stretch="Uniform" />
          </Button.Content>
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource TouchButtonStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding dodgePressed}" Value="True">
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Button.Visibility>
            <Binding Path="dodgeVisible" FallbackValue="Collapsed">
              <Binding.Converter>
                <BooleanToVisibilityConverter />
              </Binding.Converter>
            </Binding>
          </Button.Visibility>
        </Button>

      </Canvas>

      <!-- Crosshair: the screen centre, where camera-aimed shots go. Display only.
           CrosshairTrigger shows it while a weapon that fires by itself is in hand,
           turns the ring red while it is on a target, and grows the ring with the
           weapon's spread. -->
      <Grid
        Width="44"
        Height="44"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        IsHitTestVisible="False">
        <Grid.Visibility>
          <Binding Path="crosshairVisible" FallbackValue="Collapsed">
            <Binding.Converter>
              <BooleanToVisibilityConverter />
            </Binding.Converter>
          </Binding>
        </Grid.Visibility>
        <Ellipse Width="44" Height="44" StrokeThickness="3" RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform>
            <ScaleTransform
              ScaleX="{Binding crosshairScale, FallbackValue=1}"
              ScaleY="{Binding crosshairScale, FallbackValue=1}" />
          </Ellipse.RenderTransform>
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Stroke" Value="#CCFFFFFF" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding crosshairOnTarget}" Value="True">
                  <Setter Property="Stroke" Value="#FFFF3B30" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <Ellipse Width="6" Height="6" Fill="#CCFFFFFF" />
      </Grid>
    </Grid>
  </noesis:LayoutScaler>
</Component>
