<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
  mc:Ignorable="d"
  d:DesignWidth="1080" d:DesignHeight="2340">
  <noesis:LayoutScaler ReferenceResolution="1080,2340">
    <Grid Width="1080" Height="2340">
      <!-- "Garden Restored!" banner above the board, hidden until solved -->
      <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,430,0,0"
            Width="860" Height="220"
            RenderTransformOrigin="0.5,0.5" Opacity="{Binding messageOpacity}">
        <Grid.RenderTransform>
          <ScaleTransform ScaleX="{Binding messageScale}" ScaleY="{Binding messageScale}"/>
        </Grid.RenderTransform>
        <Border CornerRadius="110" Background="#55603A8A" Margin="0,12,0,-12"/>
        <Border CornerRadius="110" Background="#F2FFF4E8" BorderBrush="#FFF2C35E" BorderThickness="8"/>
        <Viewbox Margin="50,24">
          <TextBlock Text="Garden Restored!" FontSize="96" FontWeight="Bold"
                     Foreground="#FF7A4FA8" noesis:Text.Stroke="#FFFFFFFF" noesis:Text.StrokeThickness="6"/>
        </Viewbox>
      </Grid>
      <!-- Restart pill below the board (display only; taps are hit-tested by LevelHud.ts) -->
      <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,330"
            Width="400" Height="150" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
          <ScaleTransform ScaleX="{Binding restartScale}" ScaleY="{Binding restartScale}"/>
        </Grid.RenderTransform>
        <Border CornerRadius="75" Background="#50603A8A" Margin="0,8,0,-8"/>
        <Border CornerRadius="75" Background="#E6F6EEFF" BorderBrush="#FFB79BE0" BorderThickness="5"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="&#x21BB;" FontSize="72" FontWeight="Bold" Foreground="#FF7A5BB0" Margin="0,-8,18,0" VerticalAlignment="Center"/>
          <TextBlock Text="Restart" FontSize="62" FontWeight="Bold" Foreground="#FF7A5BB0" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Grid>
  </noesis:LayoutScaler>
</UserControl>
